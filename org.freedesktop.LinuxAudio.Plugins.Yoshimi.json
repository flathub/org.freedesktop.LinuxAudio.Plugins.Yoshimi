{
    "id": "org.freedesktop.LinuxAudio.Plugins.Yoshimi",
    "runtime": "org.freedesktop.LinuxAudio.BaseExtension",
    "runtime-version": "stable",
    "sdk": "org.freedesktop.Sdk//25.08",
    "build-extension": true,
    "branch": "25.08",
    "build-options": {
        "prefix": "/app/extensions/Plugins/Yoshimi",
        "prepend-pkg-config-path": "/app/extensions/Plugins/Yoshimi/lib/pkgconfig",
        "prepend-ld-library-path": "/app/extensions/Plugins/Yoshimi/lib"
    },
    "cleanup": [
        "/bin/jack*",
        "/bin/alsa*",
        "/lib/libjack*",
        "/lib/jack",
        "/lib/lv2"
    ],
    "modules": [
        {
            "name": "fltk-static",
            "buildsystem": "autotools",
            "config_opts": [
                "--enable-threads",
                "--enable-cairo",
                "--disable-wayland",
                "--disable-shared"
            ],
            "build-options": {
                "cflags": "-fPIC",
                "cxxflags": "-fPIC"
            },
            "cleanup": [
                "/bin",
                "/include",
                "/man",
                "/share/doc",
                "/share/man",
                "/lib/pkgconfig",
                "*.so",
                "*.la",
                "*.a"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/fltk/fltk/releases/download/release-1.4.4/fltk-1.4.4-source.tar.bz2",
                    "sha256": "2b302c80b7ea937a8bdc01ed6718fd995035bf63e9a2895491c1001821725f1f"
                }
            ]
        },
        {
            "name": "mxml",
            "cleanup": [
                "/bin",
                "/include",
                "/lib/pkgconfig",
                "/share/doc",
                "/share/man",
                "*.so",
                "*.a"
            ],
            "build-options": {
                "cflags": "-fPIC"
            },
            "config-opts": [
                "--disable-shared"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/michaelrsweet/mxml/releases/download/v2.12/mxml-2.12.tar.gz",
                    "sha256": "6bfb53baa1176e916855bd3b6d592fd5b962c3c259aacdb5670d90c57ce4034f"
                }
            ]
        },
        "shared-modules/linux-audio/lv2.json",
        "shared-modules/linux-audio/fftw3f-static.json",
        {
            "name": "yoshimi",
            "buildsystem": "cmake-ninja",
            "subdir": "src",
            "build-options": {
                "env": {
                    "LV2_PATH": "${FLATPAK_DEST}/lv2",
                    "LDFLAGS": "-L${FLATPAK_DEST}/lib -lpng16 -lXrender -lXcursor -lXfixes -lXext -lXft -lfontconfig -lXinerama -lpthread -ldl -lm  -lX11 -ldbus-1"
                },
                "arch": {
                    "x86_64": {
                        "config_opts": [
                            "-DBuildOptions_X86_64Core2=YES"
                        ]
                    },
                    "aarch64": {
                        "config_opts": [
                            "-DBuildOptions_RasPi4=YES"
                        ]
                    }
                }
            },
            "cleanup": [
                "/share/man"
            ],
            "post_install": [
                "install -d ${FLATPAK_DEST}/lv2",
                "mv ${FLATPAK_DEST}/lib/lv2/yoshimi.lv2 ${FLATPAK_DEST}/lv2",
                "strip ${FLATPAK_DEST}/lv2/*.lv2/*.so",
                "strip ${FLATPAK_DEST}/bin/yoshimi",
                "install -Dm644 ../org.freedesktop.LinuxAudio.Plugins.Yoshimi.metainfo.xml -t ${FLATPAK_DEST}/share/metainfo"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/Yoshimi/yoshimi/archive/refs/tags/2.3.4.2.tar.gz",
                    "sha256": "f5994486ea7b7a2412af7ebf9dbe6942519a2722342c5061eae4e95757c646db",
                    "x-checker-datai-disabled": {
                        "type": "anitya",
                        "project-id": 5290,
                        "url-template": "https://github.com/Yoshimi/yoshimi/archive/refs/tags/$version.tar.gz"
                    }
                },
                {
                    "type": "patch",
                    "path": "yoshimi-path.patch"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.LinuxAudio.Plugins.Yoshimi.metainfo.xml"
                }
            ]
        }
    ]
}
